{
  "name": "ivalice-companion",
  "version": "0.1.6",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23 || >=24.15.0 <25"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "node .github/scripts/build-desktop.mjs",
    "build:installer": "node .github/scripts/build-desktop.mjs",
    "build:web": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "tauri": "tauri",
    "check:rust": "cargo check --workspace --all-targets --locked && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --locked",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:release && npm run check:rust && npm run build",
    "test:release": "node --test .github/scripts/release-controls.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
