{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window can choose one save, invoke bounded save commands and manage its slots.",
  "windows": ["main"],
  "permissions": [
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-get-save-selection",
    "allow-set-save-selection",
    "allow-load-reader",
    "allow-preview-draft",
    "allow-preview-base-stat",
    "allow-preview-character",
    "allow-preview-job-progress",
    "allow-save-transaction",
    "allow-restore-last-backup",
    "allow-slot-operation",
    "allow-export-save-slot",
    "allow-inspect-save-file"
  ]
}
